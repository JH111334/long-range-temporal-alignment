{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepresentationArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["example_id", "encoder_id", "encoder_class", "values", "config_sha256"],
  "properties": {
    "example_id": {"type": "string", "minLength": 1},
    "encoder_id": {"type": "string", "minLength": 1},
    "encoder_class": {"enum": ["baseline", "published-equation", "operational-assumption", "proposed-method"]},
    "values": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
